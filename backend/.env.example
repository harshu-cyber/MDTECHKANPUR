# MD TechKanpur Backend Environment Variables (Production Template)

# Server Configuration
PORT=4000
NODE_ENV=production

# CORS Security (Allowed client domain)
# Set to the exact URL of your hosted frontend when live
CORS_ORIGIN=https://mdtechkanpur.com

# Rate Limiting Configuration
# RATE_LIMIT_WINDOW_MS sets the window size (900000 ms = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX limits the number of requests per IP during the window size
RATE_LIMIT_MAX=100

# Secure Cookie Signing Key
# Generate a long, high-entropy random string in production
COOKIE_SECRET=replace_this_with_a_secure_long_random_string_in_production

# MongoDB Database Connection URI
# Fallback is a local mongodb deployment if not provided
MONGODB_URI=mongodb://127.0.0.1:27017/mdtechkanpur
